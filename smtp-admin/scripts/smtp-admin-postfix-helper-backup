#!/usr/bin/env python3
import os
import sys
import subprocess
from pathlib import Path

POSTFIX = "/usr/sbin/postfix"
POSTMAP = "/usr/sbin/postmap"

ALLOWED = {
    "check": [POSTFIX, "check"],
    "reload": [POSTFIX, "reload"],
}

ALLOWED_MAP_NAMES = {
    "access", "sender_access", "recipient_access", "client_access",
    "helo_access", "virtual", "transport", "canonical",
    "header_checks", "body_checks", "generic"
}

def valid_map(path):
    p = Path(path).resolve()
    root = Path("/etc/postfix").resolve()
    return root in p.parents and p.name in ALLOWED_MAP_NAMES and p.parent == root

def main():
    if os.geteuid() != 0:
        print("must run as root", file=sys.stderr)
        return 2
    if len(sys.argv) < 2:
        return 2

    action = sys.argv[1]
    if action in ALLOWED and len(sys.argv) == 2:
        p = subprocess.run(ALLOWED[action], capture_output=True, text=True, timeout=15)
        print(p.stdout, end="")
        print(p.stderr, end="", file=sys.stderr)
        return p.returncode

    if action == "postmap" and len(sys.argv) == 3:
        path = sys.argv[2]
        if not valid_map(path):
            print("invalid Postfix map path", file=sys.stderr)
            return 2
        p = subprocess.run([POSTMAP, path], capture_output=True, text=True, timeout=15)
        print(p.stdout, end="")
        print(p.stderr, end="", file=sys.stderr)
        return p.returncode

    print("unsupported action", file=sys.stderr)
    return 2

if __name__ == "__main__":
    raise SystemExit(main())
