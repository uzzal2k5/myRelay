APP_NAME=SMTP Admin
AUTH_MODE=ad
SESSION_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_VALUE
SESSION_TIMEOUT_MINUTES=30

AD_SERVER=ldaps://dc01.example.com
AD_DOMAIN=example.com
AD_BASE_DN=DC=example,DC=com
AD_BIND_USER=svc_smtp_dashboard@example.com
AD_BIND_PASSWORD=CHANGE_ME
AD_GROUP_DN=CN=MP-SMTP-Users,OU=Groups,DC=example,DC=com

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

POSTFIX_POLICY_PATH=/etc/postfix/policy
POSTFIX_BACKUP_PATH=/etc/postfix/backup
AUDIT_LOG_PATH=/var/log/smtp-admin/audit.log

ROLE_SMTP_ADMINS=CN=SMTP-Admins,OU=Groups,DC=example,DC=com
ROLE_SECURITY_ADMINS=CN=SMTP-Security-Admins,OU=Groups,DC=example,DC=com
ROLE_READ_ONLY=CN=SMTP-ReadOnly,OU=Groups,DC=example,DC=com
